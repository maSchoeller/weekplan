@page "/rezepte"
@inject Zustand Z

<PageTitle>weekplan — Rezepte</PageTitle>

<h1>Rezepte</h1>
<p class="hinweis">
    @Z.Stamm.Rezepte.Hinweis
</p>

@foreach (var kategorie in Woche.Mahlzeiten)
{
    var rezepte = Z.Rezepte.Where(r => r.Kategorie == kategorie.Schluessel).ToList();
    if (rezepte.Count == 0) continue;

    <h2>@kategorie.Beschriftung</h2>

    <ul class="liste">
        @foreach (var rezept in rezepte)
        {
            <li>
                <a href="@($"rezepte/{rezept.Id}")">
                    <span class="name">@rezept.Name</span>
                    <span class="meta">
                        @Zahl.Kcal(rezept.Kcal) kcal
                        · @rezept.Protein g Protein
                        · @rezept.ZeitMin min@(rezept.Kalt ? " · kalt" : null)@(rezept.Prep ? " · vorkochbar" : null)
                    </span>
                    <span class="pfeil" aria-hidden="true">›</span>
                </a>
            </li>
        }
    </ul>
}
