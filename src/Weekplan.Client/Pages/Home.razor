@page "/"
@inject HttpClient Http

<PageTitle>weekplan — Verbindung</PageTitle>

<h1>weekplan</h1>
<p class="lead">
    Gerüst für den Umbau auf Client und Server. Diese Seite prüft nur eines:
    ob der Client den Server auf einer anderen Herkunft erreicht.
</p>

<section class="karte" aria-live="polite">
    <h2>Verbindung zum Server</h2>

    @if (_zustand is Zustand.Laeuft)
    {
        <p class="zeile zustand-neutral">
            <span class="zeichen" aria-hidden="true">…</span>
            <span>Wird geprüft …</span>
        </p>
    }
    else if (_zustand is Zustand.Erreichbar)
    {
        <p class="zeile zustand-gut">
            <span class="zeichen" aria-hidden="true">✓</span>
            <span>Erreichbar — Dienst <strong>@_dienst</strong> meldet „@_status".</span>
        </p>
    }
    else
    {
        <p class="zeile zustand-schlecht">
            <span class="zeichen" aria-hidden="true">✕</span>
            <span>Nicht erreichbar. @_fehler</span>
        </p>
    }

    <p class="meta">Adresse: <code>@Http.BaseAddress</code></p>

    <button class="haupt" @onclick="Pruefen" disabled="@(_zustand is Zustand.Laeuft)">
        Erneut prüfen
    </button>
</section>

@code {
    private enum Zustand { Laeuft, Erreichbar, Unerreichbar }

    private Zustand _zustand = Zustand.Laeuft;
    private string? _status;
    private string? _dienst;
    private string? _fehler;

    protected override Task OnInitializedAsync() => Pruefen();

    private async Task Pruefen()
    {
        _zustand = Zustand.Laeuft;
        _fehler = null;

        try
        {
            var antwort = await Http.GetFromJsonAsync<HealthAntwort>("health");
            if (antwort is null)
            {
                _zustand = Zustand.Unerreichbar;
                _fehler = "Der Server hat eine leere Antwort geschickt.";
                return;
            }

            _status = antwort.Status;
            _dienst = antwort.Dienst;
            _zustand = Zustand.Erreichbar;
        }
        catch (Exception ex)
        {
            // Ein CORS-Fehler kommt im Browser als HttpRequestException an, ohne
            // Statuscode — die Meldung ist deshalb bewusst wörtlich.
            _zustand = Zustand.Unerreichbar;
            _fehler = ex.Message;
        }
    }

    private sealed record HealthAntwort(string Status, string Dienst);
}
